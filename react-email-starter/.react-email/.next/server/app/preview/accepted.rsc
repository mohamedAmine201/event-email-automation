                      style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e5e7eb;margin:24px 0" />
                    <p
                      style="font-size:14px;line-height:24px;color:#6b7280;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                      The
                      <!-- -->Business Game<!-- -->
                      Team
                    </p>
                  </td>
